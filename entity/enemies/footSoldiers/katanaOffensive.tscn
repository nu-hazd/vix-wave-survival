[sub_resource type="GDScript" id="GDScript_fvs06"]
script/source = "extends Label

func _process(delta: float) -> void:
	text = \"\"\"
		Guard: %f
		Max Guard: %f
		Bar Value: %f
		Bar max value: %f
		Dir : %s
		
	\"\"\" % [
		$\"../coordinator/guard\".currentGuard,
		$\"../coordinator/guard\".maxGuard,
		$\"../coordinator/guard\".guardBar.value,
		$\"../coordinator/guard\".guardBar.max_value,
		$\"../coordinator/movement\".lastDir
	\\
		
	]
"

