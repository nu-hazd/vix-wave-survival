[sub_resource type="GDScript" id="GDScript_qgwgs"]
script/source = "extends Label


func process(delta: float) -> void:
	text = \"\"\"
			Health: %f
			Guard State: %s
			Guard: %s
			Max Guard: %s
			Movement Penaly: %s
	\"\"\" % [$\"../../health\".health, $\"../../guard\".state,$\"../../guard\".currentGuard,$\"../../guard\".maxGuard,$\"../../movement\".getCurrentMultiplier() ]
"

